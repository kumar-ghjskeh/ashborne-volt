# Ashborne Volt — local development settings. Copy to .env (never commit .env).

# Local SQLite by default. In production Render gets the Neon URL from its dashboard.
DATABASE_URL=sqlite:///data/jobs.db

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: enables "Generate with Gemini" (free key from aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Web Push alerts (private half of the VAPID pair; public half is in config.py)
VAPID_PRIVATE_KEY=

# Keep the public route allowlist on everywhere except the test suite.
ENFORCE_ROUTE_ALLOWLIST=true

PLAYWRIGHT_HEADLESS=true
REQUEST_TIMEOUT_SECONDS=30
